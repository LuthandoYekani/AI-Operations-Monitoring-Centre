      "name": "Simulated Workflow Status"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nlet validation = [];\nlet score = 100;\n\n// ---------- Scenario Simulation ----------\nswitch (data.scenario) {\n\n  case \"Healthy\":\n    data.api_status = \"ONLINE\";\n    data.records_processed = 185;\n    data.response_time_ms = 320;\n    data.error_message = \"\";\n    break;\n\n  case \"Warning\":\n    data.api_status = \"ONLINE\";\n    data.records_processed = 120;\n    data.response_time_ms = 1800;\n    data.error_message = \"High response time\";\n    score -= 25;\n    break;\n\n  case \"Critical\":\n    data.api_status = \"OFFLINE\";\n    data.records_processed = 0;\n    data.response_time_ms = 0;\n    data.error_message = \"API unavailable\";\n    score -= 60;\n    break;\n}\n\n// ---------- Validation ----------\n\nif (!data.workflow_name) {\n  validation.push(\"Missing workflow name\");\n  score -= 20;\n}\n\nif (!data.status) {\n  validation.push(\"Missing workflow status\");\n  score -= 20;\n}\n\nif (!data.last_run) {\n  validation.push(\"Missing last run\");\n  score -= 10;\n}\n\nif (data.api_status !== \"ONLINE\") {\n  validation.push(\"API Offline\");\n}\n\nreturn [{\n  json: {\n    ...data,\n    validation_results: validation,\n    validation_passed: validation.length === 0,\n    health_score: Math.max(score,0)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
